SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# Only needed once, to apply supabase/migrations/*.sql to your project.
# Dashboard: Project Settings -> Database -> Connection string -> URI
# (use the "Session pooler" or direct connection string, with the password filled in)
SUPABASE_DB_URL=

# WhatsApp Cloud API webhook (see docs/leads-api.md).
NUXT_WHATSAPP_VERIFY_TOKEN=
NUXT_WHATSAPP_APP_SECRET=
# Optional: profile id that new WhatsApp leads are assigned to.
NUXT_WHATSAPP_DEFAULT_ASSIGNEE_ID=

# Emails (new-deal alerts). Resend API key and the "from" address.
NUXT_EMAIL_RESEND_API_KEY=
NUXT_EMAIL_FROM=

# WAHA (self-hosted WhatsApp HTTP API) webhook: same URL as above, see docs/waha-webhook.md.
# Set the HMAC key and/or the secret; every one that is set must match. With neither
# set the endpoint accepts unauthenticated calls (development only).
WAHA_WEBHOOK_HMAC_KEY=
WAHA_WEBHOOK_SECRET=
# Optional: profile id WAHA leads are assigned to (falls back to NUXT_WHATSAPP_DEFAULT_ASSIGNEE_ID).
WAHA_DEFAULT_ASSIGNEE_ID=
